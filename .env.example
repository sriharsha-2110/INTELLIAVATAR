# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@db:5432/intelliavatar

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# JWT & Authentication Secret
JWT_SECRET=super-secret-jwt-signing-key-change-in-production
JWT_EXPIRATION_MINUTES=60
REFRESH_TOKEN_EXPIRATION_DAYS=7

# API Keys for AI Providers (Optional/Local Fallbacks Supported)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Vector Embeddings Config (OpenAI or Local)
EMBEDDING_MODEL=text-embedding-ada-002

# Local Model Settings
AVATAR_ENGINE=mock  # 'mock' or 'liveportrait' or 'sadtalker'
LIPSYNC_ENGINE=mock  # 'mock' or 'wav2lip' or 'musetalk'
LLM_PROVIDER=mock   # 'mock' or 'openai' or 'ollama'
TTS_PROVIDER=mock   # 'mock' or 'edge-tts' or 'elevenlabs'
ASR_PROVIDER=mock   # 'mock' or 'whisper'

# Device Configuration
DEVICE=cpu  # 'cpu' or 'cuda'

# Object Storage Settings
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=intelliavatar
STORAGE_ACCESS_KEY=minio_user
STORAGE_SECRET_KEY=minio_password

# Cost & Upload Limits
MAX_UPLOAD_SIZE_MB=20
MAX_TOKENS_PER_REQ=2048

# Feature Flags
ENABLE_RAG=true
ENABLE_MEMORY=true
ENABLE_VISION=false
ENABLE_AVATAR_TO_AVATAR=false
ENABLE_SIGN_LANGUAGE=false
ENABLE_ENTERPRISE=true
ENABLE_ANALYTICS=true
