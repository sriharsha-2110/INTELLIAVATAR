# ==========================================
# INTELLIAVATAR 2.0 Environment Configuration
# ==========================================

# Server & Network
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Database (MongoDB Atlas)
# Set your MongoDB Atlas connection string below:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/intelliavatar2?retryWrites=true&w=majority

# Cloudinary (Media & Model Asset Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI LLM Provider (Google Gemini or OpenAI)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Speech Synthesis (Azure Speech TTS)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# 3D Avatar Generation Provider (Avatar SDK / MetaPerson)
AVATAR_PROVIDER_API_KEY=your_avatarsdk_api_key_here
AVATAR_PROVIDER_BASE_URL=https://api.avatarsdk.com
